{{ banner }}
`timescale 1ns / 1ps
`default_nettype none

package {{ L.pkg }};

  // Worst-case bytes consumed before the payload begins: the longest
  // root-to-leaf path through the layer chain.
{% for lay in layers %}
  //   {{ pad(lay.name, 12) }} offset {{ pad(lay.static_offset|string if not lay.dynamic else 'dynamic, <= %d' % lay.max_offset, 24) }} {{ lay.bytes_ }} B{% if lay.is_variable %} fixed, up to {{ lay.rec.max_bytes }} B{% endif %}

{% endfor %}
  localparam int {{ L.upper }}_HDR_BYTES = {{ L.hdr_bytes }};
  localparam int {{ L.upper }}_LAYERS    = {{ layers|length }};

{% for lay in layers %}
  localparam int {{ lay.name|upper }}_BYTES = {{ lay.bytes_ }};
{% endfor %}

  // Bit position of each layer in the record bus's o_layer_valid.
  typedef enum logic [{{ max(0, (layers|length - 1).bit_length() - 1) }}:0] {
{% for lay in layers %}
    LAYER_{{ lay.name|upper }} = {{ max(1, (layers|length - 1).bit_length()) }}'d{{ lay.index }}{{ "," if not loop.last else "" }}
{% endfor %}
  } {{ L.name }}_layer_e;

{% for e in L.enums %}
  typedef enum logic [{{ e.width - 1 }}:0] {
{% for vname, value in e.values %}
    {{ e.name|upper }}_{{ vname }} = {{ sv_int(value, e.width) }}{{ "," if not loop.last else "" }}
{% endfor %}
  } {{ e.name }};

{% endfor %}
{% if L.framed %}
  // Messages. Sized so the framer never falls behind: MSG_MAX-1 bytes can be
  // left over and one beat adds KEEP_W more, so at most SLOTS messages can
  // complete in a cycle.
  localparam int {{ L.upper }}_MSG_MAX   = {{ L.msg_max }};
  localparam int {{ L.upper }}_MSG_MIN   = {{ L.msg_min }};
  localparam int {{ L.upper }}_PREFIX    = {{ L.prefix_bytes }};
  localparam int {{ L.upper }}_LEN_OFF   = {{ L.len_off }};
  localparam int {{ L.upper }}_LEN_BYTES = {{ L.len_bytes }};
  localparam int {{ L.upper }}_LEN_ADD   = {{ L.len_add }};
  localparam int {{ L.upper }}_REC_W     = {{ L.msg_rec_bits }};

  typedef enum logic [{{ L.type_field.width - 1 }}:0] {
{% for m in L.messages %}
    MSG_{{ m.name|upper }} = {{ sv_int(m.code, L.type_field.width) }}{{ "," if not loop.last else "" }}
{% endfor %}
  } {{ L.name }}_msg_e;

{% for m in L.messages %}
  localparam int {{ pad("MSG_" + m.name|upper + "_BYTES", 28) }} = {{ m.bytes_ }};
{% endfor %}

  // Bit position of each field in the message record bus. The testbench unpacks
  // o_msg_data with these, so unlike the layer offsets below they are load
  // bearing.
{% for f in L.msg_fields %}
  localparam int {{ pad("REC_" + f.name|upper + "_LSB", 28) }} = {{ pad(f.rec_lsb|string, 4) }};
  localparam int {{ pad("REC_" + f.name|upper + "_W", 28) }} = {{ pad(f.width|string, 4) }};
{% endfor %}

{% endif %}
  // Field offsets, in bits from the start of the layer that carries them.
  // Emitted for consumers of the record bus; this module does not read them,
  // hence the narrow waiver.
  /* verilator lint_off UNUSEDPARAM */
{% for lay in layers %}
{% for f in lay.fields %}
  localparam int {{ pad(lay.name|upper + "_" + f.name|upper + "_OFF", 34) }} = {{ pad(f.ir.bit_offset|string, 4) }};
  localparam int {{ pad(lay.name|upper + "_" + f.name|upper + "_W", 34) }} = {{ pad(f.width|string, 4) }};
{% endfor %}
{% endfor %}
  /* verilator lint_on UNUSEDPARAM */

endpackage

`default_nettype wire
